[Unit]
Description=Skinamp music daemon (librespot)
Documentation=https://github.com/idrewlong/skinamp
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service

[Service]
Type=notify
ExecStart=/usr/bin/skinampd
Restart=on-failure
RestartSec=2
# Hardening that leaves audio (PipeWire socket in the runtime dir), D-Bus and
# the user's own state writable.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=%h/.cache/skinamp %h/.local/share/skinamp %h/.config/skinamp %t

[Install]
WantedBy=graphical-session.target
